# Copy to .env on the server. .env is gitignored — never commit it.

# Public hostname Caddy serves and requests a certificate for.
SITE_HOST=staging.apsw.pl
# Let's Encrypt account / expiry notices.
ACME_EMAIL=piotr.solarz-wnek@apsw.pl

# SMTP relay for the contact form (msmtp). Leave SMTP_HOST empty to disable
# mail; inquiries are still written to the .logs volume.
# Cyber_Folks mailbox example: host mail.apsw.pl or the server name from the
# mailbox settings, port 465 (SSL) or 587 (STARTTLS), user = full address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@apsw.pl
SMTP_PASS=
# Envelope sender; most relays require it to be the authenticated mailbox.
SMTP_FROM=noreply@apsw.pl
