{
	email {$ACME_EMAIL}
}

# SITE_HOST comes from .env (e.g. staging.apsw.pl). Caddy obtains and renews the
# certificate itself and redirects http:// to https://. Apache keeps setting the
# security headers from .htaccess; Caddy only adds the ones it owns.
{$SITE_HOST} {
	encode zstd gzip

	# Caddy already sends X-Forwarded-For / X-Forwarded-Proto to the upstream.
	reverse_proxy apsw-site:80 {
		header_up Host {host}
	}

	log {
		output stdout
		format console
	}
}
